# Server: use the SAME Supabase project as the configured browser client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server/worker only. Never VITE_-prefix private credentials.
SUPABASE_SERVICE_ROLE_KEY=
INLITS_PUBLIC_ORIGIN=
# Persistent worker is independent of the Remix web process.
INLITS_WORKER_ENABLED=false
INLITS_AI_ENABLED=false
OPENAI_API_KEY=
# Choose a supported Responses + web-search + structured-output model explicitly.
OPENAI_MODEL=
# Hermes is a separately provisioned private service; do not enable on a shared desktop profile.
INLITS_HERMES_ENABLED=false
HERMES_ISOLATION_VERIFIED=false
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Owner-allowlisted launch only. A verified sending domain and webhook are required.
INLITS_SEND_ENABLED=false
INLITS_SEND_ALLOWED_USER_IDS=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
